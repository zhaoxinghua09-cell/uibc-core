   "expect": {"raise": "BIDDocumentError"}},
  {"id": "V19", "clause": "§4.2.4", "kind": "trusted", "note": "服务自述 verify=true、文档被动过 → 不信",
   "input": {"answer": {"verify": true, "document": {"fixture": "signed_document.json", "mutateAfterSigning": {"created": "2021-06-24T09:10:10Z"}}}},
   "expect": {"serverVerify": true, "trusted": false, "signatureOk": false}},
  {"id": "V20", "clause": "§4.2.4", "kind": "trusted", "note": "verify 是字符串 \"true\" → 协议错，不是通过",
   "input": {"answer": {"verify": "true", "document": {"fixture": "signed_document.json"}}},
   "expect": {"raise": "BIDDocumentError"}},
  {"id": "V21", "clause": "§4.2.4", "kind": "trusted", "note": "服务自述 verify=false → 是答案，不是异常",
   "input": {"answer": {"verify": false, "document": {"fixture": "signed_document.json"}}},
   "expect": {"serverVerify": false, "trusted": false}},
