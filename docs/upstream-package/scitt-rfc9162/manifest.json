{
  "class_counts": {
    "INVALID_INCLUSION_PATH": 5,
    "INVALID_LEAF_DIGEST": 1,
    "INVALID_LEAF_INDEX": 2,
    "INVALID_TREE_SIZE": 1,
    "VALID": 17,
    "VALID_BUT_SIZE_UNAUTHENTICATED": 4
  },
  "coverage_note": "Declaring a tree_size one larger than the path assumes never changes the reconstructed root in this algebra - the fold reads no additional node - so that input is carried as an ambiguous-* vector (the root does not authenticate the size), not as an INVALID_TREE_SIZE vector. INVALID_TREE_SIZE therefore covers 'declared smaller' (path one short) and 'declared zero' (no fold defined) only. This asymmetry was found by running the vectors, not assumed: an earlier draft carried a 'size larger' fail case that our own verifier reported as root-equal.",
  "leaf_entry_definition": "SHA-256 of the leaf input bytes, hex-encoded. Leaf inputs here are plain ASCII strings rather than COSE_Sign1 digests, so the tree algebra can be checked without a COSE library.",
  "reconstruction_rule": "Fold the path over leaf_index with tree_size using RFC 9162 SHA-256 verification; the result must equal root_true for VALID vectors and must differ for the three fail-* vectors.",
  "scope_note": "Covers the RFC 9162 SHA-256 hash-tree and inclusion-path layer only. No COSE_Sign1 statement or receipt bytes are included; see README 'What this set does not cover'.",
  "stability": "append-only",
  "tree_construction": "leaves[i] = SHA-256(leaf_input_i); node_hash = SHA-256(left||right); split = largest power of two below the subtree size (RFC 9162); leaf_input_i = 'scitt-rfc9162 test vectors v1 :: <vector-id> :: leaf <i>'",
  "underspecified_inputs": [
    {
      "independent_behaviour": "a literal RFC 9162 fold keeps folding and returns a root, because nothing in the text forbids size 0",
      "input": "tree_size=0 with a leaf_index asserted",
      "our_behaviour": "refused: no fold is defined, reconstructed_root left empty",
      "why_not_a_vector": "a vector has to be reproducible by an independent reading of the text. This input is not: two conforming readings disagree, so it is declared here instead of being scored. It was found on 2026-11-20 when the standalone checker disagreed with the builder; the earlier draft carried it as fail-tree-size-zero."
    }
  ],
