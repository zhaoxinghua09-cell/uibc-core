  "known_limits": [
    {
      "id": "KL-1",
      "limitation": "只改行尾（CRLF/LF）会被判 FAIL**（S4/S8）",
      "why": "证据按字节哈希，任何字节变化都必须被看见；这是\"哈希敏感\"的硬化代价，对\"无害重排版\"是误报",
      "disposition": "不改判据。列为已知限制；需要跨平台阅读时请用 `<path>.uibc` 原样字节，不要过编辑器",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-2",
      "limitation": "符号链接逃逸在 Windows 上未测**（红队 RT03）",
      "why": "Windows 默认不授予创建符号链接的权限，测试只能 SKIP",
      "disposition": "记为\"未测\"，不得记为\"通过\"；Linux 上 RT03 正常执行并按期望 FAIL",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-3",
      "limitation": "整包回滚只能带外核对**（S9）",
      "why": "回滚要比较包外 head；包内自证会把\"谁说了算\"重新交给包本身",
      "disposition": "如实写在验证报告里；不做包内自证",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-4",
      "limitation": "最强锚定只到 `anchored`，未达 `witnessed`",
      "why": "我们只有 FreeTSA 摘要时间戳 + Bitcoin 区块锚，没有第二个独立见证方为同一摘要联署",
      "disposition": "见 `docs/SPEC-PROPOSAL-v0.1.md` §5；`witnessed` 与链式见证的要求来自 **SCITT receipts/独立 witness 与 1F916-01**，不是 EP-AEC（EP-AEC `-08` 全文 `witness` 出现 0 次），明确标为差距，不声称等价",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-5",
      "limitation": "Windows 下两例测试依赖 PATH 里有可执行的 `git`",
      "why": "`test_quick_run_matches_the_receipt` 与 `test_outside_a_rebase_it_touches_nothing` 都以子进程调 `git`；PATH 里只有 `.cmd` 包装时会 `FileNotFoundError`（`CreateProcess` 不解析 `.cmd`）",
      "disposition": "Linux CI 全过；Windows 干净克隆：PATH 无 `git.exe` 时 1 失败 / 1 错误，把真实 `git.exe` 所在目录放进 PATH 后 **1082 例 OK（skipped=5，324.5 s）**。仍不写\"全平台全过\"",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-6",
      "limitation": "外部评审方收到的证据包可能落后于当前套件",
      "why": "事实包从仓库内已提交的结果 JSON 读取；若 JSON 未随套件刷新，评审方看到的是旧快照",
      "disposition": "`tools/muse_review.py` 现在会打印所用快照的文件名与 git blob，数字按快照现算，不再写死条数",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-7",
      "limitation": "撤销只有屏障，没有分发**：覆盖层缺失时默认 `ALLOW`",
      "why": "判定器只看得见递给它的文件，包内无法自证\"没有人撤销过它\"，而这正是分发层的活",
      "disposition": "`--require-revocation-coverage` 把\"缺失\"变成 `HOLD(3)`；`revocation-coverage.json` + `--coverage-max-age` + `--coverage-state` 可以要求新鲜度并拒绝序号回退（2026-11-22 四步实测：ALLOW→ROLLBACK→STALE→DENY）。仍是**自证**：同一持有者签\"没撤销\"，第三方无法独立确认",
      "source": "docs/KNOWN-LIMITS.md"
    },
    {
      "id": "KL-8",
      "limitation": "分发通道是\"拉\"，有盲窗**：`--coverage-url` 拉不到即 `HOLD`，检测延迟以轮询间隔为上界",
      "why": "没有推送通知，也没有第三方证明发布方把撤销都发出来了；轮询式验证方在两次 GET 之间是看不见新声明的",
      "disposition": "端点不可达一律 `HOLD(3)`（`coverage UNREACHABLE`），不回落 `ALLOW`；盲窗可测：本地回环、间隔 0.2 s、24 次随机相位发布 → 两次实测 median 69.3 / 136.1 ms、p95 195.0 / 198.2 ms、max 198.3 / 201.3 ms（`tools/coverage_latency.py`，中位数随发布相位浮动，理论上界仍是\"间隔 + 一次 GET\"）。对外只能说\"上界已实测\"，不能说\"实时到达\"",
      "source": "docs/KNOWN-LIMITS.md"
    }
  ],
