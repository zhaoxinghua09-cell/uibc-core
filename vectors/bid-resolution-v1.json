   "expect": {"ok": false}},
  {"id": "V17", "clause": "§5", "kind": "signature", "note": "proof.creator 指向文档里不存在的键 → 结构错（BIDDocumentError），不是签名不匹配",
   "input": {"fixture": "signed_document.json", "mutateAfterSigning": {"proof": {"creator": "did:bid:ef18F9AVK4SQLZPRrPkrVWwp9kbpdXHx#key-2", "signatureValue": "3yZe1RzM9bQ", "type": "Ed25519Signature2018"}}},
   "expect": {"raise": "BIDDocumentError"}},
  {"id": "V18", "clause": "§5", "kind": "signature", "note": "signatureValue 不是 Base58 → 结构错（BIDDocumentError），不是静默当成坏签名",
