@@ -0,0 +1,52 @@
+name: Test ledger
+
+# 每次 push 生成一份机器可核对的测试台账，并检查文档里的测试数字有没有漂移。
+# 目的：EVIDENCE-INDEX / README 不再手工维护测试数量（任务书 P1-1）。
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  ledger:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        # TODO(合并前): 固定到 commit SHA
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      - name: Install
+        run: |
+          python -m pip install --upgrade pip
+          pip install -e . || pip install -e ".[dev]" || true
+          pip install pytest
+
+      - name: Generate test ledger
+        run: python tools/gen_test_ledger.py --repo . --out evidence/test-ledger.json
+
+      - name: Scan doc claims for drift
+        # 漂移只告警、不失败：文档修正需要人工判断，不能自动改
+        continue-on-error: true
+        run: python tools/scan_claims.py --repo . --ledger evidence/test-ledger.json --out evidence/claims.json
+
+      - name: Upload ledger
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-ledger
+          path: |
+            evidence/test-ledger.json
+            evidence/claims.json
+            evidence/test-ledger.junit.xml
+          if-no-files-found: warn
diff --git a/tools/gen_test_ledger.py b/tools/gen_test_ledger.py
