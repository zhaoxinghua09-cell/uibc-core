+name: Version consistency
+
+# 发布前门禁：pyproject / __version__ / SPEC_VERSION / tag / PyPI 必须互相对齐。
+# 目的：防止以旧标签（如 uibc-core/0.3.3-proposal）指向新字节的证据报告被发布出去。
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read        # 最小权限：只读仓库
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        # TODO(合并前): 固定到 commit SHA，符合供应链要求（见审计 P1-D）
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0     # 需要 tag
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+
+      - name: Version consistency (no network)
+        run: python tools/check_version_consistency.py --repo .
+
+      - name: Version consistency (with PyPI)
+        # 网络不可达时脚本会记 pypi_unreachable，不判为不一致，避免假失败
+        run: python tools/check_version_consistency.py --repo . --check-pypi
